POSTGRES_USER=mealmind
POSTGRES_PASSWORD=mealmind
POSTGRES_DB=mealmind
DATABASE_URL=postgres://mealmind:mealmind@postgres:5432/mealmind
MEALMIND_API_BASE_URL=http://api:3001
MEALMIND_MCP_BASE_URL=http://mcp:3002
MEALMIND_RECIPE_ROOT=/app/recipes
MEALMIND_DOCS_ROOT=/app/docs
# Initial endpoint only; change saved provider configuration in MealMind Settings.
MEALMIND_AI_BASE_URL=http://host.docker.internal:1234/v1
# Optional legacy fallback while the DB credential is unset; Settings can replace or disable it.
# Leave empty for providers that do not require authentication. Never commit a real key.
# Keys saved in Settings are plaintext in PostgreSQL; protect database access and backups.
OPENAI_COMPATIBLE_API_KEY=
